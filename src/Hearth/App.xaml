<Application x:Class="Hearth.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Hearth.Views"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             StartupUri="Views/MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>

            <!-- Slot 0 is the theme token dictionary. ThemeManager replaces this
                 entry in place at runtime, so everything below must reference
                 tokens with DynamicResource, never StaticResource. -->
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Dark.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- ── Type ────────────────────────────────────────────────────
                 WPF has no letter-spacing, so the Apple feel comes from weight
                 and scale instead of tracking: Light/SemiLight at large sizes,
                 a wide jump to small secondary text, and plenty of air.
                 Segoe UI Variable is the platform's own display face. -->
            <FontFamily x:Key="Display">Segoe UI Variable Display, Segoe UI, system-ui</FontFamily>
            <FontFamily x:Key="Body">Segoe UI Variable Text, Segoe UI, system-ui</FontFamily>

            <sys:Double x:Key="TextXS">11.5</sys:Double>
            <sys:Double x:Key="TextSM">12.5</sys:Double>
            <sys:Double x:Key="TextMD">13.5</sys:Double>
            <sys:Double x:Key="TextLG">17</sys:Double>
            <sys:Double x:Key="TextXL">34</sys:Double>

            <!-- ── Motion ──────────────────────────────────────────────────
                 One vocabulary for every moving thing in the app, named for what
                 it is FOR rather than how long it lasts. Before 0013 there were
                 two durations and four easings used more or less at random, and
                 half the controls had no motion at all; the result read as jerky
                 not because any single animation was wrong but because nothing
                 agreed with anything else.

                 PERFORMANCE RULE, and it is the whole reason this is safe to
                 make longer and more pervasive: only Opacity and Transform are
                 ever animated. Both are composited per-frame from a retained
                 visual, so they cost no layout and no re-render. Animating
                 Width, Height, Margin, Padding or a Color re-runs measure and
                 arrange on every tick, which is what actually makes WPF stutter
                 (d.animate-transforms-only). -->

            <!-- Pointer feedback. Must land before the eye settles, or it reads
                 as lag rather than response. -->
            <Duration x:Key="MotionQuick">0:0:0.13</Duration>

            <!-- The default. State changes, selection, badges. -->
            <Duration x:Key="MotionBase">0:0:0.26</Duration>

            <!-- Surfaces arriving and leaving. -->
            <Duration x:Key="MotionSlow">0:0:0.44</Duration>

            <!-- The one big move: a card becoming a page. -->
            <Duration x:Key="MotionGrand">0:0:0.58</Duration>

            <!-- Whole-screen scene changes: the startup curtain, and one process
                 handing over to the next across a mode restart. Long on purpose:
                 these cover an event that genuinely takes this long, so a short
                 animation would only be followed by waiting. -->
            <Duration x:Key="MotionScene">0:0:0.82</Duration>

            <!-- Entering: fast at first, settling gently. This is the curve that
                 makes something feel like it arrived rather than appeared. -->
            <CubicEase x:Key="EaseEnter" EasingMode="EaseOut" />

            <!-- Leaving: slow to commit, then gone. -->
            <CubicEase x:Key="EaseExit" EasingMode="EaseIn" />

            <!-- Travelling between two places; symmetric so the middle is the
                 fastest part, which is how real objects move. -->
            <CubicEase x:Key="EaseTravel" EasingMode="EaseInOut" />

            <!-- Reserved for the few moments worth emphasising. Sharper
                 deceleration, so it lands with a little weight. -->
            <QuinticEase x:Key="EaseEmphasis" EasingMode="EaseOut" />

            <views:StateToBrushConverter x:Key="StateToBrush" />
            <views:SnapshotConverter x:Key="Snapshot" />

            <!-- ── Window caption buttons ──────────────────────────────────
                 Windows' own metrics: 46x32, no rounding, close goes red. Users
                 reach for these by muscle memory, so they are the one place the
                 design should not be inventive. -->
            <Style x:Key="CaptionButton" TargetType="Button">
                <Setter Property="Width" Value="46" />
                <Setter Property="Height" Value="34" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
                <Setter Property="FontSize" Value="10" />
                <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <!-- The fill is a separate layer whose OPACITY animates,
                                 rather than a Background that swaps. Swapping a brush
                                 is a step change no easing can soften; fading a layer
                                 is free and continuous. -->
                            <Grid Background="Transparent">
                                <Border x:Name="Fill"
                                        Background="{DynamicResource Hover}" Opacity="0" />
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Trigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="Fill"
                                                                 Storyboard.TargetProperty="Opacity"
                                                                 To="1" Duration="{StaticResource MotionQuick}"
                                                                 EasingFunction="{StaticResource EaseEnter}" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>
                                    <Trigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="Fill"
                                                                 Storyboard.TargetProperty="Opacity"
                                                                 To="0" Duration="{StaticResource MotionBase}"
                                                                 EasingFunction="{StaticResource EaseExit}" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.ExitActions>
                                    <Setter Property="Foreground"
                                            Value="{DynamicResource TextPrimary}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="CloseButton" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid Background="Transparent">
                                <Border x:Name="Fill"
                                        Background="{DynamicResource CloseHover}" Opacity="0" />
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Trigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="Fill"
                                                                 Storyboard.TargetProperty="Opacity"
                                                                 To="1" Duration="{StaticResource MotionQuick}"
                                                                 EasingFunction="{StaticResource EaseEnter}" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>
                                    <Trigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="Fill"
                                                                 Storyboard.TargetProperty="Opacity"
                                                                 To="0" Duration="{StaticResource MotionBase}"
                                                                 EasingFunction="{StaticResource EaseExit}" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.ExitActions>
                                    <Setter Property="Foreground" Value="White" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ── Round icon button ───────────────────────────────────────
                 The hover disc scales up from 0.7 rather than appearing, which
                 is the small thing that reads as "smooth" instead of "snappy". -->
            <Style x:Key="IconButton" TargetType="Button">
                <Setter Property="Width" Value="32" />
                <Setter Property="Height" Value="32" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid Background="Transparent" RenderTransformOrigin="0.5,0.5">
                                <Grid.RenderTransform>
                                    <ScaleTransform x:Name="PressScale" ScaleX="1" ScaleY="1" />
                                </Grid.RenderTransform>
                                <Border x:Name="Disc"
                                        Background="{DynamicResource Hover}"
                                        CornerRadius="16"
                                        Opacity="0"
                                        RenderTransformOrigin="0.5,0.5">
                                    <Border.RenderTransform>
                                        <ScaleTransform x:Name="DiscScale" ScaleX="0.72" ScaleY="0.72" />
                                    </Border.RenderTransform>
                                </Border>
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Trigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="Disc"
                                                                 Storyboard.TargetProperty="Opacity"
                                                                 To="1" Duration="{StaticResource MotionQuick}"
                                                                 EasingFunction="{StaticResource EaseEnter}" />
                                                <DoubleAnimation Storyboard.TargetName="DiscScale"
                                                                 Storyboard.TargetProperty="ScaleX"
                                                                 To="1" Duration="{StaticResource MotionQuick}"
                                                                 EasingFunction="{StaticResource EaseEnter}" />
                                                <DoubleAnimation Storyboard.TargetName="DiscScale"
                                                                 Storyboard.TargetProperty="ScaleY"
                                                                 To="1" Duration="{StaticResource MotionQuick}"
                                                                 EasingFunction="{StaticResource EaseEnter}" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>
                                    <Trigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="Disc"
                                                                 Storyboard.TargetProperty="Opacity"
                                                                 To="0" Duration="{StaticResource MotionQuick}" />
                                                <DoubleAnimation Storyboard.TargetName="DiscScale"
                                                                 Storyboard.TargetProperty="ScaleX"
                                                                 To="0.72" Duration="{StaticResource MotionBase}"
                                                                 EasingFunction="{StaticResource EaseExit}" />
                                                <DoubleAnimation Storyboard.TargetName="DiscScale"
                                                                 Storyboard.TargetProperty="ScaleY"
                                                                 To="0.72" Duration="{StaticResource MotionBase}"
                                                                 EasingFunction="{StaticResource EaseExit}" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.ExitActions>
                                    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
                                </Trigger>

                                <!-- Press feedback. A control that visibly gives
                                     under the pointer is the difference between
                                     "I clicked" and "I think I clicked". -->
                                <Trigger Property="IsPressed" Value="True">
                                    <Trigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="PressScale"
                                                                 Storyboard.TargetProperty="ScaleX"
                                                                 To="0.88" Duration="0:0:0.07"
                                                                 EasingFunction="{StaticResource EaseEnter}" />
                                                <DoubleAnimation Storyboard.TargetName="PressScale"
                                                                 Storyboard.TargetProperty="ScaleY"
                                                                 To="0.88" Duration="0:0:0.07"
                                                                 EasingFunction="{StaticResource EaseEnter}" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>
                                    <Trigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="PressScale"
                                                                 Storyboard.TargetProperty="ScaleX"
                                                                 To="1" Duration="{StaticResource MotionBase}"
                                                                 EasingFunction="{StaticResource EaseEmphasis}" />
                                                <DoubleAnimation Storyboard.TargetName="PressScale"
                                                                 Storyboard.TargetProperty="ScaleY"
                                                                 To="1" Duration="{StaticResource MotionBase}"
                                                                 EasingFunction="{StaticResource EaseEmphasis}" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.ExitActions>
                                </Trigger>

                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.28" />
                                    <Setter Property="Cursor" Value="Arrow" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ── Shield pill ─────────────────────────────────────────────
                 Sits inside the address field and appears only once the content
                 filter has refused something on the current page. It fades in
                 rather than popping, because it arrives mid-page-load and a
                 sudden badge next to the URL reads as an error.

                 Deliberately NOT accent-coloured: this is information, not a
                 warning. The accent is reserved for things the user chose. -->
            <Style x:Key="ShieldPill" TargetType="Button">
                <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
                <Setter Property="Background" Value="{DynamicResource Hover}" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="FontFamily" Value="{StaticResource Body}" />
                <Setter Property="FontSize" Value="{StaticResource TextXS}" />
                <Setter Property="Padding" Value="9,3" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid>
                                <Border Background="{TemplateBinding Background}"
                                        CornerRadius="999" />
                                <Border x:Name="Fill" CornerRadius="999"
                                        Background="{DynamicResource Accent}" Opacity="0" />
                                <ContentPresenter Margin="{TemplateBinding Padding}"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Trigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="Fill"
                                                                 Storyboard.TargetProperty="Opacity"
                                                                 To="1" Duration="{StaticResource MotionBase}"
                                                                 EasingFunction="{StaticResource EaseEnter}" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>
                                    <Trigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="Fill"
                                                                 Storyboard.TargetProperty="Opacity"
                                                                 To="0" Duration="{StaticResource MotionBase}"
                                                                 EasingFunction="{StaticResource EaseExit}" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.ExitActions>
                                    <Setter Property="Foreground"
                                            Value="{DynamicResource OnAccent}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ── Mode chip ───────────────────────────────────────────────
                 Entering immersion RESTARTS the browser
                 (k.browser-args-fixed-at-creation), so the control cannot be a
                 bare glyph with no way to say so. Through 0014 it carried its
                 label permanently, which spent tab-strip width on a button
                 pressed perhaps twice a session; now the label is revealed on
                 hover, the way a browser's overflow controls are, and the
                 tooltip still carries the warning for anyone who arrives by
                 keyboard.

                 SQUARE. The rounded pill made it read as a status badge, a thing
                 being reported rather than a thing to press, and it was the only
                 rounded control in a caption bar of square ones. -->
            <Style x:Key="ModeChip" TargetType="Button">
                <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="FontFamily" Value="{StaticResource Body}" />
                <Setter Property="FontSize" Value="{StaticResource TextSM}" />
                <Setter Property="Padding" Value="10,6" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid RenderTransformOrigin="0.5,0.5">
                                <Grid.RenderTransform>
                                    <ScaleTransform x:Name="PressScale" ScaleX="1" ScaleY="1" />
                                </Grid.RenderTransform>

                                <Border BorderThickness="1"
                                        BorderBrush="{DynamicResource Hover}" />

                                <!-- The accent fill is its own layer so it can be
                                     faded rather than switched. -->
                                <Border x:Name="Fill"
                                        Background="{DynamicResource Accent}" Opacity="0" />

                                <ContentPresenter Margin="{TemplateBinding Padding}"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Trigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="Fill"
                                                                 Storyboard.TargetProperty="Opacity"
                                                                 To="1" Duration="{StaticResource MotionBase}"
                                                                 EasingFunction="{StaticResource EaseEnter}" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>
                                    <Trigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="Fill"
                                                                 Storyboard.TargetProperty="Opacity"
                                                                 To="0" Duration="{StaticResource MotionBase}"
                                                                 EasingFunction="{StaticResource EaseExit}" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.ExitActions>
                                    <Setter Property="Foreground"
                                            Value="{DynamicResource OnAccent}" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Trigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="PressScale"
                                                                 Storyboard.TargetProperty="ScaleX"
                                                                 To="0.95" Duration="0:0:0.07" />
                                                <DoubleAnimation Storyboard.TargetName="PressScale"
                                                                 Storyboard.TargetProperty="ScaleY"
                                                                 To="0.95" Duration="0:0:0.07" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>
                                    <Trigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="PressScale"
                                                                 Storyboard.TargetProperty="ScaleX"
                                                                 To="1" Duration="{StaticResource MotionBase}"
                                                                 EasingFunction="{StaticResource EaseEmphasis}" />
                                                <DoubleAnimation Storyboard.TargetName="PressScale"
                                                                 Storyboard.TargetProperty="ScaleY"
                                                                 To="1" Duration="{StaticResource MotionBase}"
                                                                 EasingFunction="{StaticResource EaseEmphasis}" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.ExitActions>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ── Tab chip ────────────────────────────────────────────────
                 A ListBoxItem, so selection is the framework's job. The heat pip
                 stays visible at all times: the whole product argument is that
                 this cost is normally invisible.

                 The chip no longer paints its own selected background. That is
                 the travelling indicator's job now (TabIndicator in
                 MainWindow.xaml): two chips fading in opposite directions read
                 as two events, one border sliding reads as the selection
                 MOVING. Hover is still per-chip, because hover really is a
                 property of the thing under the pointer. -->
            <Style x:Key="TabChip" TargetType="ListBoxItem">
                <Setter Property="Margin" Value="0,0,3,0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Grid>
                                <Border x:Name="Ghost" CornerRadius="8"
                                        Background="{DynamicResource Hover}" Opacity="0" />
                                <ContentPresenter Margin="11,7" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Trigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="Ghost"
                                                                 Storyboard.TargetProperty="Opacity"
                                                                 To="1" Duration="{StaticResource MotionQuick}" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>
                                    <Trigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="Ghost"
                                                                 Storyboard.TargetProperty="Opacity"
                                                                 To="0" Duration="{StaticResource MotionBase}"
                                                                 EasingFunction="{StaticResource EaseExit}" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.ExitActions>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ── Address field ───────────────────────────────────────────-->
            <Style x:Key="AddressField" TargetType="TextBox">
                <Setter Property="Background" Value="{DynamicResource Surface}" />
                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
                <Setter Property="CaretBrush" Value="{DynamicResource TextPrimary}" />
                <Setter Property="SelectionBrush" Value="{DynamicResource Accent}" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="FontFamily" Value="{StaticResource Body}" />
                <Setter Property="FontSize" Value="{StaticResource TextMD}" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TextBox">
                            <Grid>
                                <Border Background="{TemplateBinding Background}"
                                        CornerRadius="9" />

                                <!-- The focus ring is a separate border that fades
                                     in. Animating BorderBrush directly would mean
                                     animating a Color, which forces a re-render of
                                     the element every tick; fading a sibling is
                                     composited (d.animate-transforms-only). -->
                                <Border x:Name="Ring" CornerRadius="9"
                                        BorderThickness="1.5"
                                        BorderBrush="{DynamicResource Accent}"
                                        Opacity="0" />

                                <ScrollViewer x:Name="PART_ContentHost" Margin="14,8" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Trigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="Ring"
                                                                 Storyboard.TargetProperty="Opacity"
                                                                 To="1" Duration="{StaticResource MotionBase}"
                                                                 EasingFunction="{StaticResource EaseEnter}" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>
                                    <Trigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="Ring"
                                                                 Storyboard.TargetProperty="Opacity"
                                                                 To="0" Duration="{StaticResource MotionBase}"
                                                                 EasingFunction="{StaticResource EaseExit}" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.ExitActions>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

        </ResourceDictionary>
    </Application.Resources>
</Application>
