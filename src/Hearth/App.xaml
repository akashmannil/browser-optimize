<Application x:Class="Hearth.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="Views/MainWindow.xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="ChromeBackground" Color="#1E1F22" />
        <SolidColorBrush x:Key="ChromeForeground" Color="#E3E3E3" />
        <SolidColorBrush x:Key="ChromeMuted"      Color="#8A8D93" />
        <SolidColorBrush x:Key="ChromeAccent"     Color="#E8833A" />
        <SolidColorBrush x:Key="ChromeField"      Color="#2B2D31" />
    </Application.Resources>
</Application>
