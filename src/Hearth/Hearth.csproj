<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <RootNamespace>Hearth</RootNamespace>
    <AssemblyName>Hearth</AssemblyName>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>

    <!-- 0.2.0-alpha.1. Sorts after 0.1.0-beta.1 because it is newer, but is
         labelled alpha deliberately: the interface was rebuilt wholesale in
         0007 and nobody outside this repo has used it yet. The memory work
         underneath is the part that is measured and settled. -->
    <Version>0.2.0</Version>
    <VersionSuffix>alpha.1</VersionSuffix>
    <AssemblyVersion>0.2.0.0</AssemblyVersion>
    <FileVersion>0.2.0.0</FileVersion>
    <InformationalVersion>0.2.0-alpha.1</InformationalVersion>
    <Product>Hearth</Product>
    <Description>A low-resource Windows browser: hibernated is a tab's default state, live is a budgeted exception.</Description>
    <Authors>akashmannil</Authors>
    <Company>akashmannil</Company>
  </PropertyGroup>

  <ItemGroup>
    <!-- Pinned to the 4078 line to match the installed WebView2 Runtime (150.0.4078.x).
         The SDK is forward-compatible, but matching the line keeps TrySuspend/
         MemoryUsageTargetLevel behaviour predictable during memory benchmarking. -->
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4078.44" />
  </ItemGroup>

</Project>
