<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <RootNamespace>Hearth</RootNamespace>
    <AssemblyName>Hearth</AssemblyName>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>

    <!-- Beta. The memory thesis is measured and holds; restore fidelity is
         partial and unverified by a human, which is what keeps this pre-1.0. -->
    <Version>0.1.0</Version>
    <VersionSuffix>beta.1</VersionSuffix>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <FileVersion>0.1.0.0</FileVersion>
    <InformationalVersion>0.1.0-beta.1</InformationalVersion>
    <Product>Hearth</Product>
    <Description>A low-resource Windows browser: hibernated is a tab's default state, live is a budgeted exception.</Description>
    <Authors>akashmannil</Authors>
    <Company>akashmannil</Company>
  </PropertyGroup>

  <ItemGroup>
    <!-- Pinned to the 4078 line to match the installed WebView2 Runtime (150.0.4078.x).
         The SDK is forward-compatible, but matching the line keeps TrySuspend/
         MemoryUsageTargetLevel behaviour predictable during memory benchmarking. -->
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4078.44" />
  </ItemGroup>

</Project>
