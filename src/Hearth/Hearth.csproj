<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <RootNamespace>Hearth</RootNamespace>
    <AssemblyName>Hearth</AssemblyName>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>

    <!-- 0.3.0-alpha.1. Still alpha: the app flow was rebuilt across 0008-0014
         (keyboard, immersion, the grid, motion, identity) and none of it has
         been used by anyone outside this repo. The memory work underneath
         remains the measured, settled part. -->
    <Version>0.3.0</Version>
    <VersionSuffix>alpha.1</VersionSuffix>
    <AssemblyVersion>0.3.0.0</AssemblyVersion>
    <FileVersion>0.3.0.0</FileVersion>
    <InformationalVersion>0.3.0-alpha.1</InformationalVersion>
    <Product>Hearth</Product>
    <AssemblyTitle>Hearth Browser</AssemblyTitle>
    <Description>A low-resource Windows browser: hibernated is a tab's default state, live is a budgeted exception.</Description>
    <Authors>akashmannil</Authors>
    <Company>akashmannil</Company>
    <Copyright>Copyright (c) 2026 akashmannil</Copyright>

    <!-- The exe's own icon: what Explorer, Alt+Tab, and a pinned taskbar entry
         use. Without it Windows falls back to the generic application icon,
         which is what made the app look anonymous next to real browsers. -->
    <ApplicationIcon>Assets\hearth.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- Also embedded as a WPF resource, because Window.Icon is a separate
         thing from ApplicationIcon: the former is the icon in the taskbar for
         a RUNNING window, the latter is the icon on the file. Setting only one
         leaves the other generic. -->
    <Resource Include="Assets\hearth.ico" />
  </ItemGroup>

  <ItemGroup>
    <!-- Pinned to the 4078 line to match the installed WebView2 Runtime (150.0.4078.x).
         The SDK is forward-compatible, but matching the line keeps TrySuspend/
         MemoryUsageTargetLevel behaviour predictable during memory benchmarking. -->
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4078.44" />
  </ItemGroup>

</Project>
