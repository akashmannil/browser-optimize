<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- Dark tokens. Neutrals are Apple's own system greys — true black ground
         with #1C1C1E / #2C2C2E surfaces, #F5F5F7 text, #86868B secondary —
         because the request was explicitly for that visual language. The ember
         accent stays: it is the one piece of Hearth's own identity, and it maps
         directly onto tab heat, so it is carrying meaning rather than decoration. -->

    <Color x:Key="BgColor">#000000</Color>
    <Color x:Key="SurfaceColor">#1C1C1E</Color>
    <Color x:Key="SurfaceRaisedColor">#2C2C2E</Color>
    <Color x:Key="AccentColor">#E8833A</Color>

    <SolidColorBrush x:Key="Bg"            Color="#000000" />
    <SolidColorBrush x:Key="Surface"       Color="#1C1C1E" />
    <SolidColorBrush x:Key="SurfaceRaised" Color="#2C2C2E" />
    <SolidColorBrush x:Key="Separator"     Color="#38383A" />

    <SolidColorBrush x:Key="TextPrimary"   Color="#F5F5F7" />
    <SolidColorBrush x:Key="TextSecondary" Color="#98989D" />
    <SolidColorBrush x:Key="TextTertiary"  Color="#636366" />

    <SolidColorBrush x:Key="Accent"        Color="#E8833A" />
    <SolidColorBrush x:Key="OnAccent"      Color="#0A0A0B" />
    <SolidColorBrush x:Key="AccentSoft"    Color="#33E8833A" />

    <SolidColorBrush x:Key="Hover"         Color="#1AFFFFFF" />
    <SolidColorBrush x:Key="Pressed"       Color="#33FFFFFF" />
    <SolidColorBrush x:Key="CloseHover"    Color="#E81123" />

    <SolidColorBrush x:Key="TabActive"     Color="#2C2C2E" />
    <SolidColorBrush x:Key="TabInactive"   Color="#00000000" />

    <!-- Tab heat. Live is ember; everything cooler runs progressively bluer and
         dimmer, so the lifecycle reads as temperature at a glance. -->
    <SolidColorBrush x:Key="StateLive"       Color="#E8833A" />
    <SolidColorBrush x:Key="StateWarm"       Color="#C9963C" />
    <SolidColorBrush x:Key="StateHibernated" Color="#5B8FC7" />
    <SolidColorBrush x:Key="StateCold"       Color="#48484A" />

    <SolidColorBrush x:Key="Scrim"         Color="#F2000000" />
    <SolidColorBrush x:Key="CardBg"        Color="#1C1C1E" />
    <SolidColorBrush x:Key="CardPlaceholder" Color="#2C2C2E" />

    <sys:Double x:Key="ShadowOpacity">0.55</sys:Double>

</ResourceDictionary>
