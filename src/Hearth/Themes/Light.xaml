<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- Light tokens. Same key set as Dark.xaml — every key here MUST exist
         there and vice versa, or a theme swap leaves unresolved brushes.
         Neutrals are Apple's: #F5F5F7 page grey, white surfaces, #1D1D1F text,
         #86868B secondary, #D2D2D7 separators.

         The accent darkens to #C25E14 rather than reusing the dark theme's
         ember: #E8833A on white fails contrast for text and reads washed out.
         Light themes are not inverted dark themes. -->

    <Color x:Key="BgColor">#F5F5F7</Color>
    <Color x:Key="SurfaceColor">#FFFFFF</Color>
    <Color x:Key="SurfaceRaisedColor">#FFFFFF</Color>
    <Color x:Key="AccentColor">#C25E14</Color>

    <SolidColorBrush x:Key="Bg"            Color="#F5F5F7" />
    <SolidColorBrush x:Key="Surface"       Color="#FFFFFF" />
    <SolidColorBrush x:Key="SurfaceRaised" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Separator"     Color="#D2D2D7" />

    <SolidColorBrush x:Key="TextPrimary"   Color="#1D1D1F" />
    <SolidColorBrush x:Key="TextSecondary" Color="#6E6E73" />
    <SolidColorBrush x:Key="TextTertiary"  Color="#86868B" />

    <SolidColorBrush x:Key="Accent"        Color="#C25E14" />
    <SolidColorBrush x:Key="OnAccent"      Color="#FFFFFF" />
    <SolidColorBrush x:Key="AccentSoft"    Color="#26C25E14" />

    <SolidColorBrush x:Key="Hover"         Color="#0F000000" />
    <SolidColorBrush x:Key="Pressed"       Color="#1F000000" />
    <SolidColorBrush x:Key="CloseHover"    Color="#E81123" />

    <SolidColorBrush x:Key="TabActive"     Color="#FFFFFF" />
    <SolidColorBrush x:Key="TabInactive"   Color="#00000000" />

    <SolidColorBrush x:Key="StateLive"       Color="#C25E14" />
    <SolidColorBrush x:Key="StateWarm"       Color="#9A6B12" />
    <SolidColorBrush x:Key="StateHibernated" Color="#2F6DA8" />
    <SolidColorBrush x:Key="StateCold"       Color="#C7C7CC" />

    <SolidColorBrush x:Key="Scrim"         Color="#F5F5F5F7" />
    <SolidColorBrush x:Key="CardBg"        Color="#FFFFFF" />
    <SolidColorBrush x:Key="CardPlaceholder" Color="#E8E8ED" />

    <sys:Double x:Key="ShadowOpacity">0.16</sys:Double>

</ResourceDictionary>
