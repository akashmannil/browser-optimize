<Window x:Class="Hearth.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Hearth" Height="860" Width="1320"
        MinHeight="480" MinWidth="720"
        WindowStyle="None"
        AllowsTransparency="False"
        Background="{DynamicResource Bg}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        PreviewKeyDown="Window_PreviewKeyDown">

    <!-- Custom chrome: the native caption is gone and the tab bar IS the title
         bar, the way every modern browser does it. CaptionHeight makes that
         strip draggable; anything interactive inside it needs
         WindowChrome.IsHitTestVisibleInChrome, which the shared styles set. -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="42"
                            ResizeBorderThickness="6"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ── Row 0 · tab bar, doubling as the title bar ───────────────── -->
        <Grid x:Name="TitleBar" Grid.Row="0" Background="{DynamicResource Bg}" Height="42">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <ScrollViewer Grid.Column="0" Margin="8,0,0,0"
                          HorizontalScrollBarVisibility="Hidden"
                          VerticalScrollBarVisibility="Disabled"
                          VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <ListBox x:Name="TabStrip"
                             Background="Transparent"
                             BorderThickness="0"
                             ItemContainerStyle="{StaticResource TabChip}"
                             SelectionChanged="TabStrip_SelectionChanged"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Disabled">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="6" Height="6" Margin="0,0,8,0"
                                             VerticalAlignment="Center"
                                             Fill="{Binding State, Converter={StaticResource StateToBrush}}"
                                             ToolTip="{Binding State}" />
                                    <TextBlock Text="{Binding DisplayLabel}"
                                               Foreground="{DynamicResource TextPrimary}"
                                               FontFamily="{StaticResource Body}"
                                               FontSize="{StaticResource TextSM}"
                                               VerticalAlignment="Center"
                                               MaxWidth="164"
                                               TextTrimming="CharacterEllipsis" />
                                    <Button Content="&#xE711;"
                                            Style="{StaticResource IconButton}"
                                            Width="18" Height="18" FontSize="9"
                                            Margin="9,0,-2,0"
                                            Tag="{Binding}"
                                            Click="CloseTab_Click" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Button Style="{StaticResource IconButton}"
                            Content="&#xE710;" FontSize="11"
                            Margin="4,0,0,0"
                            ToolTip="New tab"
                            Click="NewTab_Click" />
                </StackPanel>
            </ScrollViewer>

            <StackPanel Grid.Column="1" Orientation="Horizontal"
                        VerticalAlignment="Center" Margin="10,0,8,0">
                <Button x:Name="BigPictureButton"
                        Style="{StaticResource IconButton}"
                        Content="&#xE71B;" FontSize="13"
                        Margin="4,0,0,0"
                        ToolTip="All tabs  ·  F11"
                        Click="BigPicture_Click" />
                <Button x:Name="ThemeButton"
                        Style="{StaticResource IconButton}"
                        Content="&#xE706;" FontSize="13"
                        ToolTip="Theme"
                        Click="Theme_Click" />
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                <Button Style="{StaticResource CaptionButton}" Content="&#xE921;"
                        ToolTip="Minimise" Click="Minimise_Click" />
                <Button x:Name="MaxButton" Style="{StaticResource CaptionButton}" Content="&#xE922;"
                        ToolTip="Maximise" Click="Maximise_Click" />
                <Button Style="{StaticResource CloseButton}" Content="&#xE8BB;"
                        ToolTip="Close" Click="Close_Click" />
            </StackPanel>
        </Grid>

        <!-- ── Row 1 · navigation and address ──────────────────────────── -->
        <Grid x:Name="NavBar" Grid.Row="1" Margin="10,2,10,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0,0,8,0">
                <Button x:Name="BackButton" Style="{StaticResource IconButton}"
                        Content="&#xE72B;" ToolTip="Back" Click="Back_Click" />
                <Button x:Name="ForwardButton" Style="{StaticResource IconButton}"
                        Content="&#xE72A;" ToolTip="Forward" Click="Forward_Click" />
                <Button x:Name="ReloadButton" Style="{StaticResource IconButton}"
                        Content="&#xE72C;" ToolTip="Reload" Click="Reload_Click" />
                <Button x:Name="HomeButton" Style="{StaticResource IconButton}"
                        Content="&#xE80F;" ToolTip="Home" Click="Home_Click" />
            </StackPanel>

            <Grid Grid.Column="1">
                <TextBox x:Name="AddressBar"
                         Style="{StaticResource AddressField}"
                         KeyDown="AddressBar_KeyDown" />

                <!-- The shield only exists when the filter has actually refused
                     something on this page. A permanently visible badge is
                     decoration; one that appears exactly when a login stops
                     working is an explanation. -->
                <Button x:Name="ShieldButton"
                        Style="{StaticResource ShieldPill}"
                        HorizontalAlignment="Right" VerticalAlignment="Center"
                        Margin="0,0,6,0"
                        Visibility="Collapsed"
                        Click="Shield_Click" />
            </Grid>
        </Grid>

        <!-- ── Row 2 · web content ─────────────────────────────────────── -->
        <Grid Grid.Row="2">
            <Grid x:Name="ContentHost" />
            <Image x:Name="Placeholder"
                   Panel.ZIndex="10"
                   Visibility="Collapsed"
                   Stretch="Uniform"
                   StretchDirection="DownOnly"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Top"
                   RenderOptions.BitmapScalingMode="HighQuality" />
        </Grid>

        <!-- ── Row 3 · memory ──────────────────────────────────────────── -->
        <Border x:Name="StatusBar" Grid.Row="3" Background="{DynamicResource Bg}" Padding="16,7">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock x:Name="MemoryText"
                               Foreground="{DynamicResource TextPrimary}"
                               FontFamily="{StaticResource Body}"
                               FontSize="{StaticResource TextSM}" FontWeight="SemiBold"
                               Text="—" />
                    <TextBlock x:Name="TabsText"
                               Foreground="{DynamicResource TextTertiary}"
                               FontFamily="{StaticResource Body}"
                               FontSize="{StaticResource TextSM}" Margin="12,0,0,0"
                               Text="starting up" />
                </StackPanel>
                <TextBlock Grid.Column="1" x:Name="SavedText"
                           Foreground="{DynamicResource TextTertiary}"
                           FontFamily="{StaticResource Body}"
                           FontSize="{StaticResource TextXS}"
                           HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <!-- ── Big Picture ─────────────────────────────────────────────────
             Spans every row and takes the window fullscreen. It cannot simply
             stack above the page: WebView2 is a windowed HWND control and paints
             over all WPF content regardless of Z-order (k.wpf-airspace), so the
             content host is collapsed while this is up. -->
        <Grid x:Name="BigPicture"
              Grid.RowSpan="4"
              Panel.ZIndex="50"
              Visibility="Collapsed"
              Background="{DynamicResource Scrim}"
              Opacity="0"
              RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform>
                <ScaleTransform x:Name="BigPictureScale" ScaleX="1" ScaleY="1" />
            </Grid.RenderTransform>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="56,44,56,26">
                <StackPanel>
                    <TextBlock Text="Your tabs"
                               Foreground="{DynamicResource TextPrimary}"
                               FontFamily="{StaticResource Display}"
                               FontSize="{StaticResource TextXL}"
                               FontWeight="Light" />
                    <TextBlock x:Name="BigPictureSubtitle"
                               Foreground="{DynamicResource TextTertiary}"
                               FontFamily="{StaticResource Body}"
                               FontSize="{StaticResource TextMD}"
                               Margin="0,7,0,0" />
                </StackPanel>
                <Button Style="{StaticResource IconButton}"
                        Content="&#xE8BB;" FontSize="13"
                        HorizontalAlignment="Right" VerticalAlignment="Top"
                        ToolTip="Back to browsing  ·  Esc"
                        Click="BigPicture_Click" />
            </Grid>

            <ScrollViewer Grid.Row="1" Margin="40,0"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <ListBox x:Name="TabWall"
                         Background="Transparent"
                         BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         KeyDown="TabWall_KeyDown"
                         MouseDoubleClick="TabWall_Open">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>

                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Margin" Value="14" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Grid RenderTransformOrigin="0.5,0.5">
                                            <Grid.RenderTransform>
                                                <ScaleTransform x:Name="CardScale" ScaleX="1" ScaleY="1" />
                                            </Grid.RenderTransform>
                                            <Border x:Name="Card"
                                                    CornerRadius="16"
                                                    Background="{DynamicResource CardBg}"
                                                    BorderBrush="Transparent"
                                                    BorderThickness="2.5">
                                                <Border.Effect>
                                                    <DropShadowEffect x:Name="Shade"
                                                                      BlurRadius="26" ShadowDepth="7"
                                                                      Direction="270" Opacity="0.22"
                                                                      Color="#000000" />
                                                </Border.Effect>
                                                <ContentPresenter />
                                            </Border>
                                        </Grid>
                                        <ControlTemplate.Triggers>
                                            <!-- Cards lift on hover the way a
                                                 recents card does, rather than
                                                 just changing colour. -->
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Trigger.EnterActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetName="CardScale"
                                                                             Storyboard.TargetProperty="ScaleX"
                                                                             To="1.035" Duration="{StaticResource Medium}"
                                                                             EasingFunction="{StaticResource EaseOutStrong}" />
                                                            <DoubleAnimation Storyboard.TargetName="CardScale"
                                                                             Storyboard.TargetProperty="ScaleY"
                                                                             To="1.035" Duration="{StaticResource Medium}"
                                                                             EasingFunction="{StaticResource EaseOutStrong}" />
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </Trigger.EnterActions>
                                                <Trigger.ExitActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetName="CardScale"
                                                                             Storyboard.TargetProperty="ScaleX"
                                                                             To="1" Duration="{StaticResource Medium}"
                                                                             EasingFunction="{StaticResource EaseOut}" />
                                                            <DoubleAnimation Storyboard.TargetName="CardScale"
                                                                             Storyboard.TargetProperty="ScaleY"
                                                                             To="1" Duration="{StaticResource Medium}"
                                                                             EasingFunction="{StaticResource EaseOut}" />
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </Trigger.ExitActions>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Card" Property="BorderBrush"
                                                        Value="{DynamicResource Accent}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>

                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Width="308">
                                <Border CornerRadius="14,14,0,0" ClipToBounds="True" Height="182">
                                    <Grid>
                                        <Border Background="{DynamicResource CardPlaceholder}">
                                            <TextBlock Text="{Binding HostLabel}"
                                                       Foreground="{DynamicResource TextTertiary}"
                                                       FontFamily="{StaticResource Display}"
                                                       FontSize="{StaticResource TextLG}"
                                                       FontWeight="Light"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                        </Border>
                                        <Image Source="{Binding SnapshotPath, Converter={StaticResource Snapshot}}"
                                               Stretch="UniformToFill"
                                               StretchDirection="Both"
                                               VerticalAlignment="Top"
                                               RenderOptions.BitmapScalingMode="HighQuality" />
                                    </Grid>
                                </Border>
                                <StackPanel Margin="17,13,17,15">
                                    <TextBlock Text="{Binding Title}"
                                               Foreground="{DynamicResource TextPrimary}"
                                               FontFamily="{StaticResource Body}"
                                               FontSize="{StaticResource TextMD}"
                                               TextTrimming="CharacterEllipsis"
                                               TextWrapping="NoWrap" />
                                    <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                                        <Ellipse Width="6" Height="6" VerticalAlignment="Center"
                                                 Fill="{Binding State, Converter={StaticResource StateToBrush}}" />
                                        <TextBlock Text="{Binding HostLabel}"
                                                   Foreground="{DynamicResource TextTertiary}"
                                                   FontFamily="{StaticResource Body}"
                                                   FontSize="{StaticResource TextSM}"
                                                   Margin="8,0,0,0"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </ScrollViewer>

            <TextBlock Grid.Row="2" Margin="56,20,56,36"
                       Foreground="{DynamicResource TextTertiary}"
                       FontFamily="{StaticResource Body}"
                       FontSize="{StaticResource TextSM}"
                       Text="Arrow keys to move    Enter to open    Esc to go back" />
        </Grid>
    </Grid>
</Window>
