<Window x:Class="Hearth.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Hearth.Views"
        Title="Hearth" Height="820" Width="1280"
        Background="{StaticResource ChromeBackground}"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <!-- A tab chip. The state pip on the left is deliberately always visible:
             users are meant to SEE which tabs hold a renderer, because the whole
             product thesis is that this cost is normally invisible (p.invisible-cost). -->
        <DataTemplate x:Key="TabChipTemplate">
            <Border x:Name="Chip"
                    Background="{StaticResource ChromeField}"
                    CornerRadius="6"
                    Margin="0,0,4,0"
                    Padding="8,5">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="7" Height="7"
                             Margin="0,0,7,0"
                             VerticalAlignment="Center"
                             Fill="{Binding State, Converter={StaticResource StateToBrush}}"
                             ToolTip="{Binding State}" />

                    <TextBlock Text="{Binding DisplayLabel}"
                               Foreground="{StaticResource ChromeForeground}"
                               FontSize="12"
                               VerticalAlignment="Center"
                               MaxWidth="150"
                               TextTrimming="CharacterEllipsis" />

                    <Button Content="✕"
                            Margin="8,0,0,0"
                            Padding="3,0"
                            FontSize="10"
                            BorderThickness="0"
                            Background="Transparent"
                            Foreground="{StaticResource ChromeMuted}"
                            Cursor="Hand"
                            Tag="{Binding}"
                            Click="CloseTab_Click" />
                </StackPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Tab strip -->
        <Grid Grid.Row="0" Margin="8,8,8,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <ScrollViewer Grid.Column="0"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="TabStrip"
                              ItemTemplate="{StaticResource TabChipTemplate}"
                              PreviewMouseLeftButtonUp="TabStrip_Click">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </ScrollViewer>

            <Button Grid.Column="1"
                    Content="+"
                    Padding="12,3"
                    FontSize="15"
                    BorderThickness="0"
                    Background="{StaticResource ChromeField}"
                    Foreground="{StaticResource ChromeForeground}"
                    Cursor="Hand"
                    Click="NewTab_Click" />
        </Grid>

        <!-- Taskbar -->
        <Grid Grid.Row="1" Margin="8,4,8,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0,0,6,0">
                <Button x:Name="BackButton"    Style="{StaticResource ToolButton}"
                        Content="&#xE72B;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                        ToolTip="Back"    Click="Back_Click" />
                <Button x:Name="ForwardButton" Style="{StaticResource ToolButton}"
                        Content="&#xE72A;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                        ToolTip="Forward" Click="Forward_Click" />
                <Button x:Name="ReloadButton"  Style="{StaticResource ToolButton}"
                        Content="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                        ToolTip="Reload"  Click="Reload_Click" />
                <Button x:Name="HomeButton"    Style="{StaticResource ToolButton}"
                        Content="&#xE80F;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                        ToolTip="Home"    Click="Home_Click" />
            </StackPanel>

            <TextBox x:Name="AddressBar"
                     Grid.Column="1"
                     Background="{StaticResource ChromeField}"
                     Foreground="{StaticResource ChromeForeground}"
                     CaretBrush="{StaticResource ChromeForeground}"
                     BorderThickness="0"
                     Padding="12,7"
                     FontSize="13"
                     VerticalContentAlignment="Center"
                     KeyDown="AddressBar_KeyDown" />

            <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="6,0,0,0">
                <ToggleButton x:Name="LowPowerToggle"
                              Style="{StaticResource ModeToggle}"
                              Content="Low power"
                              ToolTip="Keep fewer pages awake and skip third-party embeds"
                              Checked="LowPower_Changed" Unchecked="LowPower_Changed" />
                <Button x:Name="BigPictureButton"
                        Style="{StaticResource ToolButton}" Width="Auto" Padding="11,5"
                        FontSize="11" Foreground="{StaticResource ChromeMuted}"
                        Content="All tabs"
                        ToolTip="Full-screen view of every tab (F11)"
                        Click="BigPicture_Click" />
            </StackPanel>
        </Grid>

        <!-- Content host: every realised WebView2 lives here, only the active one
             is Visible. Collapsed is not merely cosmetic — an invisible controller
             is a precondition for TrySuspend(). -->
        <Grid Grid.Row="2">
            <Grid x:Name="ContentHost" />

            <!-- The evicted tab's own last frame, painted while its renderer is
                 being rebuilt. Sits above the content host so the swap to live
                 content happens underneath it rather than as a visible flash. -->
            <Image x:Name="Placeholder"
                   Panel.ZIndex="10"
                   Visibility="Collapsed"
                   Stretch="Uniform"
                   StretchDirection="DownOnly"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Top"
                   RenderOptions.BitmapScalingMode="HighQuality" />
        </Grid>

        <!-- Memory strip. Deliberately always visible and stated in plain terms:
             the cost of tabs is normally invisible, and a number nobody sees
             cannot change behaviour (p.invisible-cost). Figures are measured
             from our own process tree, never estimated. -->
        <Border Grid.Row="3" Background="{StaticResource ChromeField}" Padding="12,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock x:Name="MemoryText"
                               Foreground="{StaticResource ChromeForeground}"
                               FontSize="12" FontWeight="SemiBold"
                               Text="—" />
                    <TextBlock x:Name="TabsText"
                               Foreground="{StaticResource ChromeMuted}"
                               FontSize="12" Margin="10,0,0,0"
                               Text="starting up…" />
                </StackPanel>

                <TextBlock Grid.Column="2"
                           x:Name="SavedText"
                           Foreground="{StaticResource ChromeMuted}"
                           FontSize="11"
                           HorizontalAlignment="Right" />
            </Grid>
        </Border>

        <!-- Big Picture: the wall of every tab, lean-back and keyboard-driven.
             It is not a second tab strip. Entering it drops the live budget to
             one, so browsing from here is the cheapest state the browser has —
             the aesthetic (one page at a time, everything else a picture) and
             the memory architecture happen to want exactly the same thing. -->
        <Grid x:Name="BigPicture"
              Grid.RowSpan="4"
              Panel.ZIndex="50"
              Visibility="Collapsed"
              Background="#F21A1B1E">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="40,32,40,20">
                <TextBlock Text="All tabs"
                           Foreground="{StaticResource ChromeForeground}"
                           FontSize="30" FontWeight="Light" />
                <TextBlock x:Name="BigPictureSubtitle"
                           Foreground="{StaticResource ChromeMuted}"
                           FontSize="14" Margin="0,4,0,0" />
            </StackPanel>

            <ListBox x:Name="TabWall"
                     Grid.Row="1"
                     Margin="28,0,28,0"
                     Background="Transparent"
                     BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     KeyDown="TabWall_KeyDown"
                     MouseDoubleClick="TabWall_Open">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>

                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Margin" Value="12" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Card"
                                            CornerRadius="10"
                                            Background="{StaticResource ChromeField}"
                                            BorderBrush="Transparent"
                                            BorderThickness="3"
                                            Padding="0">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Card" Property="BorderBrush"
                                                    Value="{StaticResource ChromeAccent}" />
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Card" Property="BorderBrush"
                                                    Value="#55E8833A" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>

                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Width="300">
                            <!-- The snapshot IS the hibernation artifact. The
                                 mechanism that makes tabs cheap is the same one
                                 that makes them findable. -->
                            <Grid Height="176">
                                <Border Background="#22FFFFFF" CornerRadius="7,7,0,0">
                                    <TextBlock Text="{Binding HostLabel}"
                                               Foreground="{StaticResource ChromeMuted}"
                                               FontSize="17"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>
                                <Image Source="{Binding SnapshotPath, Converter={StaticResource Snapshot}}"
                                       Stretch="UniformToFill"
                                       StretchDirection="Both"
                                       VerticalAlignment="Top"
                                       HorizontalAlignment="Center" />
                            </Grid>

                            <StackPanel Margin="14,11,14,13">
                                <TextBlock Text="{Binding Title}"
                                           Foreground="{StaticResource ChromeForeground}"
                                           FontSize="15"
                                           TextTrimming="CharacterEllipsis"
                                           MaxHeight="42"
                                           TextWrapping="Wrap" />
                                <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                                    <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                                             Fill="{Binding State, Converter={StaticResource StateToBrush}}" />
                                    <TextBlock Text="{Binding HostLabel}"
                                               Foreground="{StaticResource ChromeMuted}"
                                               FontSize="12" Margin="7,0,0,0"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <TextBlock Grid.Row="2" Margin="40,16,40,28"
                       Foreground="{StaticResource ChromeMuted}"
                       FontSize="13"
                       Text="Arrow keys to move  ·  Enter to open  ·  Esc to go back  ·  F11 to toggle" />
        </Grid>
    </Grid>
</Window>
