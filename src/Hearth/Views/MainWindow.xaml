<Window x:Class="Hearth.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Hearth" Height="800" Width="1200"
        Background="{StaticResource ChromeBackground}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Address bar -->
        <Grid Grid.Row="0" Margin="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox x:Name="AddressBar"
                     Grid.Column="0"
                     Background="{StaticResource ChromeField}"
                     Foreground="{StaticResource ChromeForeground}"
                     CaretBrush="{StaticResource ChromeForeground}"
                     BorderThickness="0"
                     Padding="10,7"
                     FontSize="13"
                     VerticalContentAlignment="Center"
                     KeyDown="AddressBar_KeyDown" />

            <Button x:Name="GoButton"
                    Grid.Column="1"
                    Content="Go"
                    Margin="8,0,0,0"
                    Padding="16,7"
                    BorderThickness="0"
                    Background="{StaticResource ChromeAccent}"
                    Foreground="#1E1F22"
                    FontWeight="SemiBold"
                    Cursor="Hand"
                    Click="GoButton_Click" />
        </Grid>

        <!-- Content -->
        <wv2:WebView2 x:Name="Browser" Grid.Row="1" />

        <!-- Status strip: this becomes the live memory budget readout in commit 5 -->
        <Border Grid.Row="2" Background="{StaticResource ChromeField}" Padding="10,5">
            <TextBlock x:Name="StatusText"
                       Foreground="{StaticResource ChromeMuted}"
                       FontSize="11"
                       Text="Initialising WebView2 environment…" />
        </Border>
    </Grid>
</Window>
