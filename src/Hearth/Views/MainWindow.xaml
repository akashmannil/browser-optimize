<Window x:Class="Hearth.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Hearth" Height="860" Width="1320"
        MinHeight="480" MinWidth="720"
        Icon="/Assets/hearth.ico"
        WindowStyle="None"
        AllowsTransparency="False"
        Background="{DynamicResource Bg}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        PreviewKeyDown="Window_PreviewKeyDown">

    <!-- Custom chrome: the native caption is gone and the tab bar IS the title
         bar, the way every modern browser does it. CaptionHeight makes that
         strip draggable; anything interactive inside it needs
         WindowChrome.IsHitTestVisibleInChrome, which the shared styles set. -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="42"
                            ResizeBorderThickness="6"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ── Row 0 · tab bar, doubling as the title bar ───────────────── -->
        <Grid x:Name="TitleBar" Grid.Row="0" Background="{DynamicResource Bg}" Height="42">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <ScrollViewer Grid.Column="0" Margin="8,0,0,0"
                          HorizontalScrollBarVisibility="Hidden"
                          VerticalScrollBarVisibility="Disabled"
                          VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                  <Grid>
                    <!-- The active-tab marker is ONE border that travels, not a
                         background that lights up on each chip in turn. Browsers
                         that move a single indicator (Safari, Arc, Firefox's
                         underline) read as continuous because the eye tracks one
                         object; fading a fill in on the destination and out on
                         the source reads as two unrelated events, which is what
                         the tab strip did through 0014.

                         It lives in a Canvas so its width can animate: a Canvas
                         gives its children infinite space and takes no size from
                         them, so a width change here re-measures this one border
                         and stops there, never reaching the tab strip let alone
                         the window (d.animate-transforms-only leaves room for
                         layout that provably cannot escape). -->
                    <Canvas x:Name="TabIndicatorLayer" IsHitTestVisible="False">
                        <Border x:Name="TabIndicator" CornerRadius="8"
                                Background="{DynamicResource TabActive}"
                                Opacity="0">
                            <Border.RenderTransform>
                                <TranslateTransform x:Name="TabIndicatorShift" />
                            </Border.RenderTransform>
                        </Border>
                    </Canvas>

                    <ListBox x:Name="TabStrip"
                             Background="Transparent"
                             BorderThickness="0"
                             ItemContainerStyle="{StaticResource TabChip}"
                             SelectionChanged="TabStrip_SelectionChanged"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Disabled">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="6" Height="6" Margin="0,0,8,0"
                                             VerticalAlignment="Center"
                                             Fill="{Binding State, Converter={StaticResource StateToBrush}}"
                                             ToolTip="{Binding State}" />
                                    <TextBlock Text="{Binding DisplayLabel}"
                                               Foreground="{DynamicResource TextPrimary}"
                                               FontFamily="{StaticResource Body}"
                                               FontSize="{StaticResource TextSM}"
                                               VerticalAlignment="Center"
                                               MaxWidth="164"
                                               TextTrimming="CharacterEllipsis" />
                                    <Button Content="&#xE711;"
                                            Style="{StaticResource IconButton}"
                                            Width="18" Height="18" FontSize="9"
                                            Margin="9,0,-2,0"
                                            Tag="{Binding}"
                                            Click="CloseTab_Click" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                  </Grid>

                    <Button Style="{StaticResource IconButton}"
                            Content="&#xE710;" FontSize="11"
                            Margin="4,0,0,0"
                            ToolTip="New tab"
                            Click="NewTab_Click" />
                </StackPanel>
            </ScrollViewer>

            <StackPanel Grid.Column="1" Orientation="Horizontal"
                        VerticalAlignment="Center" Margin="10,0,8,0">
                <!-- The slot has a FIXED width and the button is right-aligned
                     inside it, so hover expansion grows the chip leftward into
                     space that was already reserved. Nothing outside this Grid
                     re-measures, and no sibling control moves: a button that
                     shoves the theme and grid buttons sideways whenever the
                     pointer crosses it is the jitter this arrangement exists to
                     avoid. MeasureImmersionChip sets both widths from the real
                     text metrics at load. -->
                <Grid x:Name="ImmersionSlot" Margin="0,0,4,0">
                    <Button x:Name="ImmersionButton"
                            Style="{StaticResource ModeChip}"
                            HorizontalAlignment="Right"
                            Click="Immersion_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="ImmersionGlyph"
                                       Text="&#xE7C4;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="11"
                                       VerticalAlignment="Center" />

                            <!-- The label is clipped to a width that animates,
                                 and sits in a Canvas so it keeps its natural
                                 size while the clip is narrower than it. Given a
                                 zero-width constraint directly it would wrap to
                                 one character per line and change height, which
                                 is the usual reason this effect looks broken. -->
                            <Border x:Name="ImmersionLabelClip"
                                    Width="0" ClipToBounds="True"
                                    VerticalAlignment="Center">
                                <Canvas>
                                    <TextBlock x:Name="ImmersionLabel"
                                               Text="Immersion"
                                               Margin="8,0,0,0" />
                                </Canvas>
                            </Border>
                        </StackPanel>
                    </Button>
                </Grid>
                <Button x:Name="BigPictureButton"
                        Style="{StaticResource IconButton}"
                        Content="&#xE71B;" FontSize="13"
                        Margin="4,0,0,0"
                        ToolTip="All tabs  ·  F9"
                        Click="BigPicture_Click" />
                <Button x:Name="ThemeButton"
                        Style="{StaticResource IconButton}"
                        Content="&#xE706;" FontSize="13"
                        ToolTip="Theme"
                        Click="Theme_Click" />
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                <Button Style="{StaticResource CaptionButton}" Content="&#xE921;"
                        ToolTip="Minimise" Click="Minimise_Click" />
                <Button x:Name="MaxButton" Style="{StaticResource CaptionButton}" Content="&#xE922;"
                        ToolTip="Maximise" Click="Maximise_Click" />
                <Button Style="{StaticResource CloseButton}" Content="&#xE8BB;"
                        ToolTip="Close" Click="Close_Click" />
            </StackPanel>
        </Grid>

        <!-- ── Row 1 · navigation and address ──────────────────────────── -->
        <Grid x:Name="NavBar" Grid.Row="1" Margin="10,2,10,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0,0,8,0">
                <Button x:Name="BackButton" Style="{StaticResource IconButton}"
                        Content="&#xE72B;" ToolTip="Back" Click="Back_Click" />
                <Button x:Name="ForwardButton" Style="{StaticResource IconButton}"
                        Content="&#xE72A;" ToolTip="Forward" Click="Forward_Click" />
                <Button x:Name="ReloadButton" Style="{StaticResource IconButton}"
                        Content="&#xE72C;" ToolTip="Reload" Click="Reload_Click" />
                <Button x:Name="HomeButton" Style="{StaticResource IconButton}"
                        Content="&#xE80F;" ToolTip="Home" Click="Home_Click" />
            </StackPanel>

            <Grid Grid.Column="1">
                <TextBox x:Name="AddressBar"
                         Style="{StaticResource AddressField}"
                         KeyDown="AddressBar_KeyDown" />

                <!-- The shield only exists when the filter has actually refused
                     something on this page. A permanently visible badge is
                     decoration; one that appears exactly when a login stops
                     working is an explanation. -->
                <Button x:Name="ShieldButton"
                        Style="{StaticResource ShieldPill}"
                        HorizontalAlignment="Right" VerticalAlignment="Center"
                        Margin="0,0,6,0"
                        Visibility="Collapsed"
                        Click="Shield_Click" />
            </Grid>
        </Grid>

        <!-- ── Row 2 · web content ─────────────────────────────────────── -->
        <Grid Grid.Row="2" x:Name="ContentArea">
            <Grid x:Name="ContentHost" />

            <!-- UniformToFill and top-aligned, so it occupies the pane exactly
                 the way the page will. It used to be Uniform/DownOnly/centred,
                 which letterboxed the snapshot and made the swap to live content
                 a visible jump rather than a dissolve. It is also what the grid
                 hands its zoomed card off to, so the picture that flew up to
                 fill the screen is the same picture that is still there while
                 the page loads behind it. -->
            <Image x:Name="Placeholder"
                   Panel.ZIndex="10"
                   Visibility="Collapsed"
                   Stretch="UniformToFill"
                   HorizontalAlignment="Stretch"
                   VerticalAlignment="Top"
                   RenderOptions.BitmapScalingMode="HighQuality" />

            <!-- Indeterminate load indicator. Only ever visible while the
                 placeholder is up: once the page paints, WebView2 covers all
                 WPF content anyway (k.wpf-airspace), which happens to be exactly
                 when there is nothing left to wait for. -->
            <Border x:Name="LoadingBar"
                    Height="2" VerticalAlignment="Top"
                    Panel.ZIndex="20"
                    Visibility="Collapsed"
                    ClipToBounds="True"
                    Background="Transparent">
                <Rectangle Width="240" HorizontalAlignment="Left"
                           Fill="{DynamicResource Accent}">
                    <Rectangle.RenderTransform>
                        <TranslateTransform x:Name="LoadingShift" X="-240" />
                    </Rectangle.RenderTransform>
                </Rectangle>
            </Border>
        </Grid>

        <!-- ── Row 3 · memory ──────────────────────────────────────────── -->
        <Border x:Name="StatusBar" Grid.Row="3" Background="{DynamicResource Bg}" Padding="16,7">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock x:Name="MemoryText"
                               Foreground="{DynamicResource TextPrimary}"
                               FontFamily="{StaticResource Body}"
                               FontSize="{StaticResource TextSM}" FontWeight="SemiBold"
                               Text="—" />
                    <TextBlock x:Name="TabsText"
                               Foreground="{DynamicResource TextTertiary}"
                               FontFamily="{StaticResource Body}"
                               FontSize="{StaticResource TextSM}" Margin="12,0,0,0"
                               Text="starting up" />
                </StackPanel>
                <TextBlock Grid.Column="1" x:Name="SavedText"
                           Foreground="{DynamicResource TextTertiary}"
                           FontFamily="{StaticResource Body}"
                           FontSize="{StaticResource TextXS}"
                           HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <!-- ── Tab grid ────────────────────────────────────────────────────
             Spans rows 1-3, NOT the whole window, and never changes the window
             size. That one detail is what makes it mode-aware for free: in
             browse the tab strip stays visible above it and the grid fills the
             window; in immersion the strip is already collapsed, so the same
             markup fills the screen. The grid takes the shape the app is
             currently in rather than imposing one (d.grid-inherits-the-mode).

             It cannot simply stack above the page: WebView2 is a windowed HWND
             control and paints over all WPF content regardless of Z-order
             (k.wpf-airspace), so the content host is collapsed while this is
             up. -->
        <Grid x:Name="BigPicture"
              Grid.Row="1" Grid.RowSpan="3"
              Panel.ZIndex="50"
              Visibility="Collapsed"
              Background="Transparent"
              RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform>
                <ScaleTransform x:Name="BigPictureScale" ScaleX="1" ScaleY="1" />
            </Grid.RenderTransform>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- The scrim is its own leaf so the entrance can fade IT rather than
                 the whole grid. Animating Opacity on a large subtree forces WPF
                 to composite that subtree into an offscreen surface every frame;
                 measured, fading this container cost roughly a third of the
                 frame rate (~107 fps down to ~69). Opacity is only cheap on
                 leaves (k.subtree-opacity-is-not-free). -->
            <Border x:Name="GridScrim" Grid.RowSpan="3"
                    Background="{DynamicResource Scrim}" Opacity="0" />

            <Grid x:Name="GridHeader" Grid.Row="0" Margin="44,30,44,20" Opacity="0">
                <StackPanel>
                    <TextBlock Text="Your tabs"
                               Foreground="{DynamicResource TextPrimary}"
                               FontFamily="{StaticResource Display}"
                               FontSize="{StaticResource TextXL}"
                               FontWeight="Light" />
                    <TextBlock x:Name="BigPictureSubtitle"
                               Foreground="{DynamicResource TextTertiary}"
                               FontFamily="{StaticResource Body}"
                               FontSize="{StaticResource TextMD}"
                               Margin="0,7,0,0" />
                </StackPanel>
                <Button Style="{StaticResource IconButton}"
                        Content="&#xE8BB;" FontSize="13"
                        HorizontalAlignment="Right" VerticalAlignment="Top"
                        ToolTip="Back to browsing  ·  Esc"
                        Click="BigPicture_Click" />
            </Grid>

            <!-- The ListBox scrolls itself. It used to sit inside an outer
                 ScrollViewer, which handed it infinite height: it never
                 virtualised, and ScrollIntoView had nothing to scroll, so
                 keyboard selection silently walked off the bottom of the
                 screen. -->
            <ListBox x:Name="TabWall" Grid.Row="1" Margin="30,0"
                     Background="Transparent"
                     BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     KeyDown="TabWall_KeyDown">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>

                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Margin" Value="14" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Cursor" Value="Hand" />

                            <!-- ONE click opens the tab. It used to take a
                                 double-click, which is the main reason the grid
                                 read as broken: a single click selected a card
                                 and appeared to do nothing at all. Nothing else
                                 in this app, or in any tab switcher anyone has
                                 used, needs two clicks to pick a thing. -->
                            <EventSetter Event="PreviewMouseLeftButtonUp"
                                         Handler="TabCard_Click" />

                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Grid RenderTransformOrigin="0.5,0.5">
                                            <Grid.RenderTransform>
                                                <ScaleTransform x:Name="CardScale" ScaleX="1" ScaleY="1" />
                                            </Grid.RenderTransform>
                                            <!-- No DropShadowEffect. A blur is
                                                 recomputed every frame for every
                                                 card, and with a dozen cards
                                                 scaling and fading at once it was
                                                 the heaviest thing in the app.
                                                 Elevation now comes from a
                                                 hairline plus background
                                                 contrast, which costs nothing per
                                                 frame (k.effects-are-per-frame). -->
                                            <Border x:Name="Card"
                                                    CornerRadius="16"
                                                    Background="{DynamicResource CardBg}"
                                                    BorderBrush="{DynamicResource Hover}"
                                                    BorderThickness="1">
                                                <ContentPresenter />
                                            </Border>
                                        </Grid>
                                        <ControlTemplate.Triggers>
                                            <!-- Cards lift on hover the way a
                                                 recents card does, rather than
                                                 just changing colour. -->
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Trigger.EnterActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetName="CardScale"
                                                                             Storyboard.TargetProperty="ScaleX"
                                                                             To="1.035" Duration="{StaticResource MotionBase}"
                                                                             EasingFunction="{StaticResource EaseEmphasis}" />
                                                            <DoubleAnimation Storyboard.TargetName="CardScale"
                                                                             Storyboard.TargetProperty="ScaleY"
                                                                             To="1.035" Duration="{StaticResource MotionBase}"
                                                                             EasingFunction="{StaticResource EaseEmphasis}" />
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </Trigger.EnterActions>
                                                <Trigger.ExitActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetName="CardScale"
                                                                             Storyboard.TargetProperty="ScaleX"
                                                                             To="1" Duration="{StaticResource MotionBase}"
                                                                             EasingFunction="{StaticResource EaseEnter}" />
                                                            <DoubleAnimation Storyboard.TargetName="CardScale"
                                                                             Storyboard.TargetProperty="ScaleY"
                                                                             To="1" Duration="{StaticResource MotionBase}"
                                                                             EasingFunction="{StaticResource EaseEnter}" />
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </Trigger.ExitActions>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Card" Property="BorderThickness"
                                                        Value="2.5" />
                                                <Setter TargetName="Card" Property="BorderBrush"
                                                        Value="{DynamicResource Accent}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>

                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Width="308">
                                <Border CornerRadius="14,14,0,0" ClipToBounds="True" Height="182">
                                    <Grid>
                                        <Border Background="{DynamicResource CardPlaceholder}">
                                            <TextBlock Text="{Binding HostLabel}"
                                                       Foreground="{DynamicResource TextTertiary}"
                                                       FontFamily="{StaticResource Display}"
                                                       FontSize="{StaticResource TextLG}"
                                                       FontWeight="Light"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                        </Border>
                                        <Image Source="{Binding SnapshotPath, Converter={StaticResource Snapshot}}"
                                               Stretch="UniformToFill"
                                               StretchDirection="Both"
                                               VerticalAlignment="Top"
                                               RenderOptions.BitmapScalingMode="HighQuality" />
                                    </Grid>
                                </Border>
                                <StackPanel Margin="17,13,17,15">
                                    <TextBlock Text="{Binding Title}"
                                               Foreground="{DynamicResource TextPrimary}"
                                               FontFamily="{StaticResource Body}"
                                               FontSize="{StaticResource TextMD}"
                                               TextTrimming="CharacterEllipsis"
                                               TextWrapping="NoWrap" />
                                    <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                                        <Ellipse Width="6" Height="6" VerticalAlignment="Center"
                                                 Fill="{Binding State, Converter={StaticResource StateToBrush}}" />
                                        <TextBlock Text="{Binding HostLabel}"
                                                   Foreground="{DynamicResource TextTertiary}"
                                                   FontFamily="{StaticResource Body}"
                                                   FontSize="{StaticResource TextSM}"
                                                   Margin="8,0,0,0"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
            </ListBox>

            <TextBlock x:Name="GridFooter" Grid.Row="2" Margin="44,16,44,26" Opacity="0"
                       Foreground="{DynamicResource TextTertiary}"
                       FontFamily="{StaticResource Body}"
                       FontSize="{StaticResource TextSM}"
                       Text="Click a card to open it    Arrow keys to move    1-9 to jump    Esc to go back" />

        <!-- The zoom-to-open surface. A card cannot be scaled up in place: it
             lives inside the ListBox's own ScrollViewer, which clips to its
             bounds, so the card would be cut off exactly as it got interesting.
             Opening instead paints a copy of the card here, over every row, and
             flies that. -->
        <Canvas x:Name="ZoomLayer"
                Grid.Row="0" Grid.RowSpan="3"
                Panel.ZIndex="60"
                IsHitTestVisible="False" />
        </Grid>
    </Grid>
</Window>
