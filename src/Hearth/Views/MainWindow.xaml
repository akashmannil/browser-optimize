<Window x:Class="Hearth.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Hearth" Height="820" Width="1280"
        Background="{StaticResource ChromeBackground}">

    <Window.Resources>
        <!-- A tab chip. The state pip on the left is deliberately always visible:
             users are meant to SEE which tabs hold a renderer, because the whole
             product thesis is that this cost is normally invisible (p.invisible-cost). -->
        <DataTemplate x:Key="TabChipTemplate">
            <Border x:Name="Chip"
                    Background="{StaticResource ChromeField}"
                    CornerRadius="6"
                    Margin="0,0,4,0"
                    Padding="8,5">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="7" Height="7"
                             Margin="0,0,7,0"
                             VerticalAlignment="Center"
                             Fill="{Binding State, Converter={StaticResource StateToBrush}}"
                             ToolTip="{Binding State}" />

                    <TextBlock Text="{Binding DisplayLabel}"
                               Foreground="{StaticResource ChromeForeground}"
                               FontSize="12"
                               VerticalAlignment="Center"
                               MaxWidth="150"
                               TextTrimming="CharacterEllipsis" />

                    <Button Content="✕"
                            Margin="8,0,0,0"
                            Padding="3,0"
                            FontSize="10"
                            BorderThickness="0"
                            Background="Transparent"
                            Foreground="{StaticResource ChromeMuted}"
                            Cursor="Hand"
                            Tag="{Binding}"
                            Click="CloseTab_Click" />
                </StackPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Tab strip -->
        <Grid Grid.Row="0" Margin="8,8,8,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <ScrollViewer Grid.Column="0"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="TabStrip"
                              ItemTemplate="{StaticResource TabChipTemplate}"
                              PreviewMouseLeftButtonUp="TabStrip_Click">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </ScrollViewer>

            <Button Grid.Column="1"
                    Content="+"
                    Padding="12,3"
                    FontSize="15"
                    BorderThickness="0"
                    Background="{StaticResource ChromeField}"
                    Foreground="{StaticResource ChromeForeground}"
                    Cursor="Hand"
                    Click="NewTab_Click" />
        </Grid>

        <!-- Address bar -->
        <Grid Grid.Row="1" Margin="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox x:Name="AddressBar"
                     Grid.Column="0"
                     Background="{StaticResource ChromeField}"
                     Foreground="{StaticResource ChromeForeground}"
                     CaretBrush="{StaticResource ChromeForeground}"
                     BorderThickness="0"
                     Padding="10,7"
                     FontSize="13"
                     VerticalContentAlignment="Center"
                     KeyDown="AddressBar_KeyDown" />

            <Button Grid.Column="1"
                    Content="Go"
                    Margin="8,0,0,0"
                    Padding="16,7"
                    BorderThickness="0"
                    Background="{StaticResource ChromeAccent}"
                    Foreground="#1E1F22"
                    FontWeight="SemiBold"
                    Cursor="Hand"
                    Click="GoButton_Click" />
        </Grid>

        <!-- Content host: every realised WebView2 lives here, only the active one
             is Visible. Collapsed is not merely cosmetic — an invisible controller
             is a precondition for TrySuspend() in commit 0003. -->
        <Grid x:Name="ContentHost" Grid.Row="2" />

        <!-- Status strip: becomes the live memory budget readout in commit 0005 -->
        <Border Grid.Row="3" Background="{StaticResource ChromeField}" Padding="10,5">
            <TextBlock x:Name="StatusText"
                       Foreground="{StaticResource ChromeMuted}"
                       FontSize="11"
                       Text="Initialising WebView2 environment…" />
        </Border>
    </Grid>
</Window>
